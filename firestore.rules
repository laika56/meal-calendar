rules_version = '2';

// 개인 건강 데이터다. Firebase Web SDK의 apiKey 는 공개 식별자이므로
// 이 파일이 유일한 방어선이다 (docs/ARCHITECTURE.md 「왜 프록시가 필수인가」).
//
// 기본은 거부다. 아래에 명시적으로 열어준 경로만 통과한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── 사용자 본인 데이터 ────────────────────────────────────────────
    // 익명 인증이라도 uid 는 발급된다. 남의 uid 문서는 못 읽고 못 쓴다.
    // {document=**} 가 하위 컬렉션(goals/days/presets)을 전부 덮는다.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ── 공용 식품 캐시 ───────────────────────────────────────────────
    // 외부 API 응답을 정규화해 캐싱하는 곳. 로그인한 사용자는 읽을 수 있지만
    // 쓰기는 Cloud Functions(Admin SDK, 규칙을 우회한다)만 한다.
    // 클라이언트가 쓸 수 있으면 남의 검색 결과를 오염시킬 수 있다.
    match /foods/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── 버전 관리 프랜차이즈 카탈로그 ─────────────────────────────────
    // 검수 데이터의 적재와 검색은 Admin SDK를 쓰는 Cloud Functions만 한다.
    // 인증된 클라이언트도 run 상태나 스냅샷을 직접 읽거나 쓸 수 없다.
    match /franchiseCatalogState/{id} {
      allow read, write: if false;
    }

    match /franchiseCatalogRuns/{runId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ── 그 외 전부 거부 ──────────────────────────────────────────────
    // 새 컬렉션을 추가하면 여기서 막힌다. 그게 의도다 —
    // 규칙을 먼저 쓰지 않으면 데이터가 안 들어간다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
