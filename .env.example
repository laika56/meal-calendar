# 복사해서 .env 로 쓴다. .env 는 절대 커밋하지 않는다.
#
# 아래 값들은 전부 Cloud Functions 에서만 읽는다.
# 프론트엔드(src/) 에서 참조하는 순간 브라우저에 노출된다.

# 공공데이터포털 — 식약처 식품영양성분DB
# https://www.data.go.kr/data/15127578/openapi.do
MFDS_API_KEY=

# Anthropic API — 룰렛 설명 문구 생성 (선택 기능)
# 비어 있으면 설명 없이 solver 결과만 보여준다
ANTHROPIC_API_KEY=

# Open Food Facts 는 키가 필요 없다. 대신 User-Agent 를 요구한다.
OFF_USER_AGENT=meal-calendar/0.1 (personal use)
